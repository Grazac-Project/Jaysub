# Supabase project URL, from your project dashboard
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase secret API key (sb_secret_...). Server only.
# Never prefix this variable with NEXT_PUBLIC_ or commit a real key.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Your final primary domain, including https:// (no path).
# Production canonical domain for Jaysub Enterprise.
# Required for correct production canonical URLs and sitemap links.
SITE_URL=https://www.jaysub.com
# Optional Search Console HTML-tag verification content, not the full tag.
GOOGLE_SITE_VERIFICATION=
# Set true to keep a non-public/staging deployment out of search.
SITE_NOINDEX=false
